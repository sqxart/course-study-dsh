# Private config for this machine. The installer copies this file to
# local/private.toml in the install directory; local/ is gitignored and is never
# exported or uploaded. A missing local/private.toml means the public default:
# mode = "evidence", submit = false.
#
# mode = "evidence"    only submit answers backed by subtitle/original text;
#                      a missing citation stops before submission.
# mode = "completion"  allow subject-knowledge inference, submit it and record
#                      low_confidence = true. Private use only.
mode = "evidence"

[playback]
# 0 = use the highest rate the platform's own player menu offers.
# 1 = conservative: never above 1x (some courses flag faster playback).
# Any other value must exist in the menu; otherwise the skill falls back to 1x.
rate = 0

[quiz]
# Public default: read the quiz, show the evidence, do NOT submit.
# Opening the answer page may create an attempt record on the platform; check the
# quiz's attempt limit before letting the skill open it.
# Set true only on an account whose owner has explicitly authorised submission.
submit = false

# Retry a chapter quiz once when it did not score full marks.
# Requires submit = true and remaining attempts on the platform.
redo_once = false

[asr]
# Transcribe a video that has no subtitle track, so the quiz can still be answered from
# the lecture's own words. Works on an uncompleted node: the player exposes a signed mp4
# as soon as the page loads, so nothing has to be watched first, and it can run while the
# video plays.
#   true  = no subtitles -> ASR transcription -> answer with the transcript
#   false = old behaviour: no subtitles -> subject-knowledge inference (low confidence),
#           and sections without subtitles are skipped in the knowledge document
#
# Optional: the rest of the skill works without it. Enabling needs all three of
#   1) ffmpeg + ffprobe on PATH
#   2) an API key: local/mimo.key, $MIMO_API_KEY, $ASR_API_KEY, or --provider-key-env
#   3) this switch set to true
# The default provider is MiMo (model mimo-v2.5-asr). Any OpenAI-compatible endpoint that
# accepts the same `input_audio` chat payload works; free/local routes are in references/asr.md.
# MiMo invite (author's referral link, entirely optional): code KQDN7K
#   https://platform.xiaomimimo.com?ref=KQDN7K  -> both sides get ¥10 credit + 10% off the first order
enabled = false
# 600-second chunks made the model repeat one paragraph; 90 seconds is the tested value.
chunk_seconds = 90
# Leave the four below commented to use the MiMo defaults.
# endpoint = "https://api.xiaomimimo.com/v1/chat/completions"
# model = "mimo-v2.5-asr"
# auth_style = "api-key"          # "bearer" for most other providers
# key_file = "local/mimo.key"

[limits]
# Advisory budget, not a code gate: the executor records the call count in
# evidence.json and flags overruns. 30 is the warm-node target; a cold run can
# exceed it (the 1.2.1 pre-run used 37 calls, the 1.2.2 retest 19).
max_calls_per_node = 30
