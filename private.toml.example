# Private config for this machine. The installer copies this file to
# local/private.toml in the install directory; local/ is gitignored and is never
# exported or uploaded. A missing local/private.toml means the public default:
# mode = "evidence", submit = false.
#
# mode = "evidence"    only submit answers backed by subtitle/original text;
#                      a missing citation stops before submission.
# mode = "completion"  allow subject-knowledge inference, submit it and record
#                      low_confidence = true. Private use only.
mode = "evidence"

[playback]
# 0 = use the highest rate the platform's own player menu offers.
# 1 = conservative: never above 1x (some courses flag faster playback).
# Any other value must exist in the menu; otherwise the skill falls back to 1x.
rate = 0

[quiz]
# Public default: read the quiz, show the evidence, do NOT submit.
# Opening the answer page may create an attempt record on the platform; check the
# quiz's attempt limit before letting the skill open it.
# Set true only on an account whose owner has explicitly authorised submission.
submit = false

# Retry a chapter quiz once when it did not score full marks.
# Requires submit = true and remaining attempts on the platform.
redo_once = false

[limits]
# Advisory budget, not a code gate: the executor records the call count in
# evidence.json and flags overruns. 30 is the warm-node target; a cold run can
# exceed it (the 1.2.1 pre-run used 37 calls, the 1.2.2 retest 19).
max_calls_per_node = 30
